---
import "../styles/global.css";
import { site } from "../data/site";
import { asset, page } from "../lib/paths";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const wa = `https://wa.me/${site.whatsapp}`;
const logo = asset("images/Logo-FB-blanco-sin-fondo-02.png");
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={logo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Oswald:wght@500;600&display=swap" rel="stylesheet" />
  </head>
  <body class:list={["court", { "is-admin": noindex }]}>
    <nav>
      <div class="wrap">
        <a class="brand" href={page("")}>
          <img src={logo} alt="Liga FB" />
          LIGA FB
        </a>
        <ul class="nav-links">
          <li><a href={page("")} aria-current={path.endsWith("/liga-fb/") || path.endsWith("/liga-fb") ? "page" : undefined}>Inicio</a></li>
          <li><a href={page("ranking/")} aria-current={path.includes("/ranking") ? "page" : undefined}>Ranking</a></li>
          <li><a href={page("academia/")} aria-current={path.includes("/academia") ? "page" : undefined}>Academia</a></li>
          <li><a href={page("sedes/")} aria-current={path.includes("/sedes") ? "page" : undefined}>Sedes</a></li>
        </ul>
        <div class="nav-actions">
          <a class="nav-cta nav-cta-ghost" href={page("admin/")}>Admin</a>
          <a class="nav-cta" href={page("inscripcion/")}>Sumate</a>
        </div>
        <button class="menu-btn" type="button" data-menu>Menu</button>
      </div>
    </nav>
    <slot />
    <footer>
      <div class="wrap">
        <div>
          <strong>LIGA FB ® {site.year}</strong>
          <p>Pádel nocturno y academia · {site.city}, {site.province}</p>
        </div>
        <div>
          <a href={site.instagram} target="_blank" rel="noreferrer">Instagram</a>
          ·
          <a href={page("inscripcion/")}>WhatsApp</a>
        </div>
      </div>
    </footer>
    <a class="wa" href={wa} title="WhatsApp">WA</a>
    <script>
      document.querySelector("[data-menu]")?.addEventListener("click", () => {
        document.querySelector("nav")?.classList.toggle("open");
      });
    </script>
  </body>
</html>
