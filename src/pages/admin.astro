---
import Layout from "../layouts/Layout.astro";
import ranking from "../data/ranking.json";
import fixtureData from "../data/fixture.json";
import { site } from "../data/site";
import auth from "../data/admin-auth.json";

const HIDDEN_CATS = new Set(["S Masculina"]);
const rows = ranking.filter((p) => !HIDDEN_CATS.has((p as { cat: string }).cat));
---
<Layout title="Admin | Liga FB" description="Panel para cargar ranking y datos de Liga FB." noindex>
  <div class="wrap admin-gate" id="gate">
    <form class="admin-card form" id="login-form" autocomplete="off">
      <p class="kicker">Panel interno</p>
      <h1>Admin Liga FB</h1>
      <div class="admin-step" id="step-pass">
        <p class="admin-help">Ingresá usuario y clave.</p>
        <label>Usuario
          <input id="user" name="liga-user" autocomplete="off" autocapitalize="off" spellcheck="false" />
        </label>
        <label>Clave
          <input id="pass" name="liga-pass" type="password" autocomplete="new-password" />
        </label>
        <div class="admin-login-actions">
          <button class="btn btn-lime" type="submit" id="login-next">Continuar</button>
        </div>
      </div>
      <div class="admin-step" id="step-otp" hidden>
        <p class="admin-help">Ahora el código de 6 dígitos del autenticador.</p>
        <label>Código
          <input id="otp" class="admin-otp" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
        </label>
        <div class="admin-login-actions">
          <button class="btn btn-lime" type="submit" id="login">Entrar</button>
          <button class="btn btn-ghost" type="button" id="login-back">Volver</button>
        </div>
      </div>
      <p class="admin-msg" id="login-msg"></p>
    </form>
  </div>

  <div class="wrap admin-app" id="app" hidden>
    <p class="kicker">Panel interno</p>
    <h1>Cargar y editar</h1>
    <div class="admin-toolbar">
      <details class="admin-pub">
        <summary>Publicar</summary>
        <input id="gh-token" type="password" placeholder="Token de publicación" autocomplete="off" />
      </details>
      <button class="btn btn-ghost" type="button" id="logout">Salir</button>
    </div>

    <div class="admin-tabs">
      <button class="pill on" type="button" data-tab="ranking">Ranking</button>
      <button class="pill" type="button" data-tab="fixture">Fixture</button>
      <button class="pill" type="button" data-tab="sitio">Datos del sitio</button>
    </div>

    <section id="tab-ranking">
      <div class="admin-panel">
        <div class="admin-toolbar">
          <select id="f-temp"></select>
          <select id="f-cat"></select>
          <input id="f-q" type="search" placeholder="Buscar…" />
        </div>
        <div class="admin-toolbar">
          <button class="btn btn-ghost" type="button" id="add">+ Jugador</button>
          <button class="btn btn-ghost" type="button" id="csv-model">Modelo CSV</button>
          <button class="btn btn-ghost" type="button" id="csv-export">Exportar CSV</button>
          <label class="btn btn-ghost" style="cursor:pointer">
            Importar CSV
            <input id="csv" type="file" accept=".csv,.txt,.tsv" hidden />
          </label>
          <label class="chk"><input id="replace-temp" type="checkbox" checked /> Reemplazar temporada del CSV</label>
        </div>
        <div class="admin-toolbar">
          <button class="btn btn-lime" type="button" id="publish">Publicar ranking</button>
        </div>
      </div>
      <p class="admin-help">Modelo CSV: name,cat,pts,pj,dif,pos,temp — descargalo, completá en Excel y volvé a importar.</p>
      <p class="admin-msg" id="rank-msg"></p>
      <p class="tag" id="rank-count"></p>
      <div class="admin-scroll">
        <table class="admin-table">
          <thead>
            <tr>
              <th class="col-pos">#</th>
              <th>Nombre / pareja</th>
              <th class="col-cat">Categoría</th>
              <th class="col-num">PJ</th>
              <th class="col-num">Dif</th>
              <th class="col-num">Pts</th>
              <th class="col-temp">Temp</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="tbody"></tbody>
        </table>
      </div>
    </section>

    <section id="tab-fixture" hidden>
      <div class="admin-panel">
        <div class="admin-toolbar">
          <button class="btn btn-ghost" type="button" id="fx-add">+ Partido</button>
          <button class="btn btn-ghost" type="button" id="fx-model">Modelo CSV</button>
          <button class="btn btn-ghost" type="button" id="fx-export">Exportar CSV</button>
          <label class="btn btn-ghost" style="cursor:pointer">
            Importar CSV
            <input id="fx-csv" type="file" accept=".csv,.txt,.tsv" hidden />
          </label>
        </div>
        <div class="admin-toolbar">
          <button class="btn btn-lime" type="button" id="fx-publish">Publicar fixture</button>
        </div>
      </div>
      <p class="admin-help">Columnas del modelo: week,date,temp,cat,time,venue,home,away,result</p>
      <p class="admin-msg" id="fx-msg"></p>
      <div class="admin-scroll">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Semana</th>
              <th>Fecha</th>
              <th>Hora</th>
              <th>Temp</th>
              <th>Categoría</th>
              <th>Sede</th>
              <th>Local</th>
              <th>Visitante</th>
              <th>Resultado</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="fx-body"></tbody>
        </table>
      </div>
    </section>

    <section id="tab-sitio" hidden>
      <form class="form" id="site-form" style="max-width:640px">
        <label>Temporada en juego
          <input name="currentSeason" />
        </label>
        <label>WhatsApp (549…)
          <input name="whatsapp" />
        </label>
        <label>Instagram
          <input name="instagram" />
        </label>
        <label>Ciudad
          <input name="city" />
        </label>
        <label>Provincia
          <input name="province" />
        </label>
        <label>Texto de la liga
          <textarea name="ligaIntro" rows="6"></textarea>
        </label>
        <button class="btn btn-lime" type="submit">Publicar datos del sitio</button>
      </form>
      <p class="admin-msg" id="site-msg"></p>
    </section>
  </div>

  <script define:vars={{ initialRows: rows, initialSite: site, initialFixture: fixtureData, auth }}>
    const KEY = "liga-fb-gh-token";
    const AUTH_KEY = "liga-fb-admin-ok";
    const PASS_SALT = "liga-fb-admin-v1";
    const owner = initialSite.githubOwner;
    const repo = initialSite.githubRepo;
    const RANK_PATH = "src/data/ranking.json";
    const SITE_PATH = "src/data/site.json";
    const FIXTURE_PATH = "src/data/fixture.json";
    const RANK_COLS = ["name", "cat", "pts", "pj", "dif", "pos", "temp"];
    const FX_COLS = ["week", "date", "temp", "cat", "time", "venue", "home", "away", "result"];
    const CATS = ["A Masculina", "B Masculina", "C Masculina", "A Femenino", "B Femenino", "C Femenino"];

    let rows = structuredClone(initialRows);
    let siteData = structuredClone(initialSite);
    let fixture = structuredClone(initialFixture || []);
    let token = sessionStorage.getItem(KEY) || "";

    const $ = (id) => document.getElementById(id);
    const gate = $("gate");
    const app = $("app");

    function toB64(str) {
      return btoa(unescape(encodeURIComponent(str)));
    }
    function fromB64(b64) {
      return decodeURIComponent(escape(atob(b64)));
    }
    function headers() {
      return {
        Accept: "application/vnd.github+json",
        Authorization: "Bearer " + token,
        "X-GitHub-Api-Version": "2022-11-28",
      };
    }
    function msg(el, text, kind) {
      el.textContent = text;
      el.className = "admin-msg" + (kind ? " " + kind : "");
    }
    function num(v) {
      const n = Number(v);
      return Number.isFinite(n) ? n : 0;
    }
    function cleanRow(r) {
      return {
        name: String(r.name || "").trim(),
        cat: String(r.cat || "").trim(),
        pts: num(r.pts),
        pj: num(r.pj),
        dif: num(r.dif),
        pos: num(r.pos),
        temp: String(r.temp || siteData.currentSeason || "T4").trim().toUpperCase(),
      };
    }

    async function api(path, opts = {}) {
      const res = await fetch("https://api.github.com" + path, {
        ...opts,
        headers: { ...headers(), ...(opts.headers || {}) },
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(data.message || "Error GitHub " + res.status);
      }
      return data;
    }

    async function publishFile(filePath, content, message) {
      const file = await api(`/repos/${owner}/${repo}/contents/${filePath}`);
      await api(`/repos/${owner}/${repo}/contents/${filePath}`, {
        method: "PUT",
        body: JSON.stringify({
          message,
          content: toB64(content),
          sha: file.sha,
          branch: "main",
        }),
      });
    }

    function temps() {
      return [...new Set(rows.map((r) => r.temp))].sort();
    }
    function catsInView() {
      const t = $("f-temp").value;
      const list = t === "TODAS" ? rows : rows.filter((r) => r.temp === t);
      return [...new Set(list.map((r) => r.cat))].sort();
    }

    function fillFilters() {
      const tempSel = $("f-temp");
      const catSel = $("f-cat");
      const prevT = tempSel.value || siteData.currentSeason || "T4";
      const prevC = catSel.value || "TODAS";
      tempSel.innerHTML =
        `<option value="TODAS">Todas las temporadas</option>` +
        temps().map((t) => `<option value="${t}">${t}</option>`).join("");
      if ([...tempSel.options].some((o) => o.value === prevT)) tempSel.value = prevT;
      catSel.innerHTML =
        `<option value="TODAS">Todas las categorías</option>` +
        catsInView().map((c) => `<option value="${c}">${c}</option>`).join("");
      if ([...catSel.options].some((o) => o.value === prevC)) catSel.value = prevC;
    }

    function visible() {
      const t = $("f-temp").value;
      const c = $("f-cat").value;
      const q = ($("f-q").value || "").trim().toLowerCase();
      return rows
        .map((r, i) => ({ r, i }))
        .filter(({ r }) => {
          if (t !== "TODAS" && r.temp !== t) return false;
          if (c !== "TODAS" && r.cat !== c) return false;
          if (q && !(r.name || "").toLowerCase().includes(q)) return false;
          return true;
        });
    }

    function renderTable() {
      const list = visible();
      $("rank-count").textContent = list.length + " filas visibles · " + rows.length + " en total";
      $("tbody").innerHTML = list
        .map(({ r, i }) => {
          const catOpts = [...new Set([...CATS, r.cat].filter(Boolean))]
            .map((c) => `<option ${c === r.cat ? "selected" : ""}>${c}</option>`)
            .join("");
          const tempOpts = [...new Set([...(temps().length ? temps() : ["T4"]), r.temp])]
            .map((t) => `<option ${t === r.temp ? "selected" : ""}>${t}</option>`)
            .join("");
          return `<tr data-i="${i}">
            <td class="col-pos"><input data-k="pos" type="number" value="${r.pos}" /></td>
            <td><input data-k="name" value="${String(r.name).replace(/"/g, "&quot;")}" /></td>
            <td class="col-cat"><select data-k="cat">${catOpts}</select></td>
            <td class="col-num"><input data-k="pj" type="number" value="${r.pj}" /></td>
            <td class="col-num"><input data-k="dif" type="number" value="${r.dif}" /></td>
            <td class="col-num"><input data-k="pts" type="number" value="${r.pts}" /></td>
            <td class="col-temp"><select data-k="temp">${tempOpts}</select></td>
            <td><button class="btn-danger" type="button" data-del="${i}">X</button></td>
          </tr>`;
        })
        .join("");
    }

    function fillSiteForm() {
      const form = $("site-form");
      form.currentSeason.value = siteData.currentSeason || "T4";
      form.whatsapp.value = siteData.whatsapp || "";
      form.instagram.value = siteData.instagram || "";
      form.city.value = siteData.city || "";
      form.province.value = siteData.province || "";
      form.ligaIntro.value = siteData.ligaIntro || "";
    }

    function csvCell(v) {
      const s = String(v ?? "");
      return /[",\n;]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
    }
    function downloadCsv(filename, cols, data) {
      const body = [cols.join(","), ...data.map((row) => cols.map((c) => csvCell(row[c])).join(","))].join("\n");
      const a = document.createElement("a");
      a.href = URL.createObjectURL(new Blob(["\uFEFF" + body + "\n"], { type: "text/csv;charset=utf-8" }));
      a.download = filename;
      a.click();
    }
    function cleanMatch(m) {
      return {
        week: String(m.week || "").trim(),
        date: String(m.date || "").trim(),
        temp: String(m.temp || siteData.currentSeason || "T4").trim().toUpperCase(),
        cat: String(m.cat || "").trim(),
        time: String(m.time || "").trim(),
        venue: String(m.venue || "").trim(),
        home: String(m.home || "").trim(),
        away: String(m.away || "").trim(),
        result: String(m.result || "").trim(),
      };
    }
    function renderFixture() {
      $("fx-body").innerHTML = fixture
        .map((m, i) => `<tr data-i="${i}">
          <td><input data-k="week" value="${String(m.week || "").replace(/"/g, "&quot;")}" /></td>
          <td><input data-k="date" value="${String(m.date || "").replace(/"/g, "&quot;")}" placeholder="2026-08-17" /></td>
          <td><input data-k="time" value="${String(m.time || "").replace(/"/g, "&quot;")}" placeholder="21:00" /></td>
          <td><input data-k="temp" value="${String(m.temp || "").replace(/"/g, "&quot;")}" /></td>
          <td><input data-k="cat" value="${String(m.cat || "").replace(/"/g, "&quot;")}" /></td>
          <td><input data-k="venue" value="${String(m.venue || "").replace(/"/g, "&quot;")}" /></td>
          <td><input data-k="home" value="${String(m.home || "").replace(/"/g, "&quot;")}" /></td>
          <td><input data-k="away" value="${String(m.away || "").replace(/"/g, "&quot;")}" /></td>
          <td><input data-k="result" value="${String(m.result || "").replace(/"/g, "&quot;")}" /></td>
          <td><button class="btn-danger" type="button" data-fx-del="${i}">X</button></td>
        </tr>`)
        .join("");
    }
    function showApp() {
      gate.hidden = true;
      app.hidden = false;
      $("gh-token").value = token;
      fillFilters();
      renderTable();
      renderFixture();
      fillSiteForm();
    }

    function timingEqual(a, b) {
      if (a.length !== b.length) return false;
      let out = 0;
      for (let i = 0; i < a.length; i++) out |= a.charCodeAt(i) ^ b.charCodeAt(i);
      return out === 0;
    }

    async function sha256hex(str) {
      const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(str));
      return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, "0")).join("");
    }

    function base32Decode(input) {
      const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
      const clean = String(input).toUpperCase().replace(/=+$/g, "").replace(/[^A-Z2-7]/g, "");
      let bits = "";
      for (const ch of clean) bits += alphabet.indexOf(ch).toString(2).padStart(5, "0");
      const bytes = [];
      for (let i = 0; i + 8 <= bits.length; i += 8) bytes.push(parseInt(bits.slice(i, i + 8), 2));
      return new Uint8Array(bytes);
    }

    async function hotp(secretBytes, counter) {
      const key = await crypto.subtle.importKey("raw", secretBytes, { name: "HMAC", hash: "SHA-1" }, false, ["sign"]);
      const buf = new ArrayBuffer(8);
      const view = new DataView(buf);
      view.setUint32(0, Math.floor(counter / 0x100000000));
      view.setUint32(4, counter >>> 0);
      const sig = new Uint8Array(await crypto.subtle.sign("HMAC", key, buf));
      const offset = sig[sig.length - 1] & 0xf;
      const code =
        ((sig[offset] & 0x7f) << 24) | (sig[offset + 1] << 16) | (sig[offset + 2] << 8) | sig[offset + 3];
      return String(code % 1_000_000).padStart(6, "0");
    }

    async function totpOk(secret, code) {
      const want = String(code || "").replace(/\s/g, "");
      if (!/^\d{6}$/.test(want)) return false;
      const secretBytes = base32Decode(secret);
      const now = Math.floor(Date.now() / 1000 / 30);
      for (const delta of [-1, 0, 1]) {
        if (timingEqual(await hotp(secretBytes, now + delta), want)) return true;
      }
      return false;
    }

    let passReady = false;
    $("login-back").addEventListener("click", () => {
      passReady = false;
      $("step-otp").hidden = true;
      $("step-pass").hidden = false;
      $("otp").value = "";
      msg($("login-msg"), "");
    });
    $("login-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      msg($("login-msg"), "Validando…");
      try {
        if (!passReady) {
          const userOk = ($("user").value || "").trim().toLowerCase() === String(auth.user).toLowerCase();
          const hash = await sha256hex(PASS_SALT + ($("pass").value || ""));
          const passOk = timingEqual(hash, auth.passwordHash);
          if (!userOk || !passOk) throw new Error("Usuario o clave incorrectos.");
          passReady = true;
          $("step-pass").hidden = true;
          $("step-otp").hidden = false;
          $("otp").focus();
          msg($("login-msg"), "");
          return;
        }
        const otpOk = await totpOk(auth.totpSecret, $("otp").value);
        if (!otpOk) throw new Error("Código del autenticador incorrecto.");
        sessionStorage.setItem(AUTH_KEY, "1");
        showApp();
      } catch (err) {
        sessionStorage.removeItem(AUTH_KEY);
        msg($("login-msg"), err.message, "err");
      }
    });

    $("gh-token").addEventListener("change", () => {
      token = $("gh-token").value.trim();
      if (token) sessionStorage.setItem(KEY, token);
      else sessionStorage.removeItem(KEY);
    });

    $("logout").addEventListener("click", () => {
      sessionStorage.removeItem(AUTH_KEY);
      location.reload();
    });

    document.querySelectorAll("[data-tab]").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll("[data-tab]").forEach((b) => b.classList.remove("on"));
        btn.classList.add("on");
        $("tab-ranking").hidden = btn.dataset.tab !== "ranking";
        $("tab-fixture").hidden = btn.dataset.tab !== "fixture";
        $("tab-sitio").hidden = btn.dataset.tab !== "sitio";
      });
    });

    $("f-temp").addEventListener("change", () => {
      fillFilters();
      renderTable();
    });
    $("f-cat").addEventListener("change", renderTable);
    $("f-q").addEventListener("input", renderTable);

    $("tbody").addEventListener("change", (e) => {
      const tr = e.target.closest("tr");
      if (!tr) return;
      const i = Number(tr.dataset.i);
      const k = e.target.dataset.k;
      if (!k) return;
      rows[i][k] = k === "name" || k === "cat" || k === "temp" ? e.target.value : num(e.target.value);
    });
    $("tbody").addEventListener("click", (e) => {
      const btn = e.target.closest("[data-del]");
      if (!btn) return;
      rows.splice(Number(btn.dataset.del), 1);
      fillFilters();
      renderTable();
    });

    $("add").addEventListener("click", () => {
      const temp = $("f-temp").value === "TODAS" ? siteData.currentSeason || "T4" : $("f-temp").value;
      const cat = $("f-cat").value === "TODAS" ? "A Masculina" : $("f-cat").value;
      rows.push(cleanRow({ name: "", cat, pts: 0, pj: 0, dif: 0, pos: 1, temp }));
      $("f-q").value = "";
      renderTable();
      const last = $("tbody").querySelector("tr:last-child input[data-k=name]");
      last?.focus();
    });

    function parseCsv(text) {
      const raw = text.replace(/^\uFEFF/, "").trim();
      const first = raw.split(/\r?\n/, 1)[0] || "";
      const sep = first.includes("\t") ? "\t" : first.includes(";") ? ";" : ",";
      const lines = raw.split(/\r?\n/).filter((l) => l.trim());
      const split = (line) => {
        const out = [];
        let cur = "";
        let q = false;
        for (let i = 0; i < line.length; i++) {
          const ch = line[i];
          if (ch === '"') {
            q = !q;
          } else if (ch === sep && !q) {
            out.push(cur.trim());
            cur = "";
          } else cur += ch;
        }
        out.push(cur.trim());
        return out;
      };
      const header = split(lines[0]).map((h) => h.toLowerCase());
      const idx = (names) => names.map((n) => header.indexOf(n)).find((i) => i >= 0) ?? -1;
      const map = {
        name: idx(["name", "nombre", "jugador", "pareja", "player"]),
        cat: idx(["cat", "categoria", "categoría"]),
        pts: idx(["pts", "puntos", "points"]),
        pj: idx(["pj", "jugados", "played"]),
        dif: idx(["dif", "diferencia", "sets"]),
        pos: idx(["pos", "posicion", "posición", "#"]),
        temp: idx(["temp", "temporada", "season"]),
      };
      const hasHeader = map.name >= 0;
      const fallbackTemp = $("f-temp").value === "TODAS" ? siteData.currentSeason || "T4" : $("f-temp").value;
      return (hasHeader ? lines.slice(1) : lines)
        .map((line) => {
          const cols = split(line);
          if (hasHeader) {
            const get = (k) => (map[k] >= 0 ? cols[map[k]] : "");
            return cleanRow({
              name: get("name"),
              cat: get("cat"),
              pts: get("pts"),
              pj: get("pj"),
              dif: get("dif"),
              pos: get("pos") || 0,
              temp: get("temp") || fallbackTemp,
            });
          }
          return cleanRow({
            pos: cols[0],
            name: cols[1],
            cat: cols[2],
            pj: cols[3],
            dif: cols[4],
            pts: cols[5],
            temp: cols[6] || fallbackTemp,
          });
        })
        .filter((r) => r.name && r.cat.toLowerCase() !== "s masculina");
    }

    $("csv-model").addEventListener("click", () => {
      downloadCsv("modelo-ranking.csv", RANK_COLS, [{
        name: "Apellido, Nombre / Apellido, Nombre",
        cat: "A Masculina",
        pts: 0,
        pj: 0,
        dif: 0,
        pos: 1,
        temp: siteData.currentSeason || "T4",
      }]);
      msg($("rank-msg"), "Descargué el modelo CSV de ranking. Completalo y usá Importar CSV.", "ok");
    });
    $("csv-export").addEventListener("click", () => {
      downloadCsv("ranking-liga-fb.csv", RANK_COLS, rows.map(cleanRow));
      msg($("rank-msg"), "Exporté el ranking actual.", "ok");
    });

    $("csv").addEventListener("change", async (e) => {
      const file = e.target.files?.[0];
      e.target.value = "";
      if (!file) return;
      try {
        const parsed = parseCsv(await file.text());
        if (!parsed.length) throw new Error("El CSV no tiene filas válidas.");
        if ($("replace-temp").checked) {
          const tempsIn = [...new Set(parsed.map((r) => r.temp))];
          rows = rows.filter((r) => !tempsIn.includes(r.temp)).concat(parsed);
          msg($("rank-msg"), `Reemplacé ${tempsIn.join(", ")} · ${parsed.length} filas.`, "ok");
        } else {
          rows = rows.concat(parsed);
          msg($("rank-msg"), `Agregué ${parsed.length} filas.`, "ok");
        }
        fillFilters();
        renderTable();
      } catch (err) {
        msg($("rank-msg"), err.message, "err");
      }
    });

    $("publish").addEventListener("click", async () => {
      token = $("gh-token").value.trim();
      if (!token) {
        msg($("rank-msg"), "Para publicar en el sitio pegá un token de GitHub (Contents: write).", "err");
        $("gh-token").focus();
        return;
      }
      sessionStorage.setItem(KEY, token);
      rows = rows.map(cleanRow).filter((r) => r.name && r.cat.toLowerCase() !== "s masculina");
      msg($("rank-msg"), "Publicando ranking…");
      try {
        await publishFile(
          RANK_PATH,
          JSON.stringify(rows, null, 2) + "\n",
          "Actualiza ranking desde el admin."
        );
        msg($("rank-msg"), "Ranking publicado. El sitio se actualiza en ~1 minuto.", "ok");
        fillFilters();
        renderTable();
      } catch (err) {
        msg($("rank-msg"), err.message, "err");
      }
    });

    $("fx-add").addEventListener("click", () => {
      fixture.push(cleanMatch({
        week: "Semana 1",
        date: "",
        temp: siteData.currentSeason || "T4",
        cat: "A Masculina",
        time: "21:00",
        venue: "Palermo Pádel",
        home: "",
        away: "",
        result: "",
      }));
      renderFixture();
    });
    $("fx-body").addEventListener("change", (e) => {
      const tr = e.target.closest("tr");
      if (!tr) return;
      const i = Number(tr.dataset.i);
      const k = e.target.dataset.k;
      if (!k) return;
      fixture[i][k] = e.target.value;
    });
    $("fx-body").addEventListener("click", (e) => {
      const btn = e.target.closest("[data-fx-del]");
      if (!btn) return;
      fixture.splice(Number(btn.dataset.fxDel), 1);
      renderFixture();
    });
    $("fx-model").addEventListener("click", () => {
      downloadCsv("modelo-fixture.csv", FX_COLS, [{
        week: "Semana 1",
        date: "2026-08-17",
        temp: siteData.currentSeason || "T4",
        cat: "A Masculina",
        time: "21:00",
        venue: "Palermo Pádel",
        home: "Apellido / Apellido",
        away: "Apellido / Apellido",
        result: "",
      }]);
      msg($("fx-msg"), "Descargué el modelo CSV de fixture. Completalo y usá Importar CSV.", "ok");
    });
    $("fx-export").addEventListener("click", () => {
      downloadCsv("fixture-liga-fb.csv", FX_COLS, fixture.map(cleanMatch));
      msg($("fx-msg"), "Exporté el fixture actual.", "ok");
    });
    $("fx-csv").addEventListener("change", async (e) => {
      const file = e.target.files?.[0];
      e.target.value = "";
      if (!file) return;
      try {
        const text = (await file.text()).replace(/^\uFEFF/, "").trim();
        const first = text.split(/\r?\n/, 1)[0] || "";
        const sep = first.includes("\t") ? "\t" : first.includes(";") ? ";" : ",";
        const lines = text.split(/\r?\n/).filter((l) => l.trim());
        const split = (line) => {
          const out = [];
          let cur = "";
          let q = false;
          for (let i = 0; i < line.length; i++) {
            const ch = line[i];
            if (ch === '"') q = !q;
            else if (ch === sep && !q) {
              out.push(cur.trim());
              cur = "";
            } else cur += ch;
          }
          out.push(cur.trim());
          return out;
        };
        const header = split(lines[0]).map((h) => h.toLowerCase());
        const idx = (name) => header.indexOf(name);
        const parsed = lines.slice(1).map((line) => {
          const cols = split(line);
          const get = (k) => (idx(k) >= 0 ? cols[idx(k)] : "");
          return cleanMatch({
            week: get("week") || get("semana"),
            date: get("date") || get("fecha"),
            temp: get("temp") || get("temporada"),
            cat: get("cat") || get("categoria") || get("categoría"),
            time: get("time") || get("hora"),
            venue: get("venue") || get("sede"),
            home: get("home") || get("local"),
            away: get("away") || get("visitante"),
            result: get("result") || get("resultado"),
          });
        }).filter((m) => m.home || m.away);
        if (!parsed.length) throw new Error("El CSV no tiene partidos válidos.");
        fixture = parsed;
        renderFixture();
        msg($("fx-msg"), `Importé ${parsed.length} partidos.`, "ok");
      } catch (err) {
        msg($("fx-msg"), err.message, "err");
      }
    });
    $("fx-publish").addEventListener("click", async () => {
      token = $("gh-token").value.trim();
      if (!token) {
        msg($("fx-msg"), "Para publicar pegá un token de GitHub arriba (Contents: write).", "err");
        $("gh-token").focus();
        return;
      }
      sessionStorage.setItem(KEY, token);
      fixture = fixture.map(cleanMatch).filter((m) => m.home || m.away);
      msg($("fx-msg"), "Publicando fixture…");
      try {
        await publishFile(
          FIXTURE_PATH,
          JSON.stringify(fixture, null, 2) + "\n",
          "Actualiza fixture desde el admin."
        );
        msg($("fx-msg"), "Fixture publicado. El sitio se actualiza en ~1 minuto.", "ok");
        renderFixture();
      } catch (err) {
        msg($("fx-msg"), err.message, "err");
      }
    });

    $("site-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      token = $("gh-token").value.trim();
      if (!token) {
        msg($("site-msg"), "Para publicar pegá un token de GitHub arriba (Contents: write).", "err");
        $("gh-token").focus();
        return;
      }
      sessionStorage.setItem(KEY, token);
      const form = e.target;
      siteData = {
        ...siteData,
        currentSeason: form.currentSeason.value.trim() || "T4",
        whatsapp: form.whatsapp.value.trim(),
        instagram: form.instagram.value.trim(),
        city: form.city.value.trim(),
        province: form.province.value.trim(),
        ligaIntro: form.ligaIntro.value.trim(),
      };
      msg($("site-msg"), "Publicando datos…");
      try {
        await publishFile(
          SITE_PATH,
          JSON.stringify(siteData, null, 2) + "\n",
          "Actualiza datos del sitio desde el admin."
        );
        msg($("site-msg"), "Datos publicados. El sitio se actualiza en ~1 minuto.", "ok");
      } catch (err) {
        msg($("site-msg"), err.message, "err");
      }
    });

    if (sessionStorage.getItem(AUTH_KEY) === "1") showApp();
  </script>
</Layout>
